<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="MauiApp.Pages.MainMenuPage"
             Shell.NavBarIsVisible="False"
             Title="三国战棋"
             BackgroundColor="{StaticResource PixelInk}">

    <Grid>
        <skia:SKCanvasView x:Name="BgCanvas" PaintSurface="OnPaintBackground" />

        <Grid RowDefinitions="*,Auto,*" Padding="32">
            <VerticalStackLayout Grid.Row="1" Spacing="14" HorizontalOptions="Center" WidthRequest="320">

                <Label Text="三国战棋"
                       Style="{StaticResource PixelTitle}"
                       Shadow="{x:Null}" />
                <Label Text="乡 野 初 阵"
                       Style="{StaticResource PixelLabel}"
                       FontSize="16"
                       TextColor="{StaticResource PixelParchmentText}"
                       Opacity="0.85"
                       HorizontalTextAlignment="Center" />

                <BoxView HeightRequest="2" Color="{StaticResource PixelGoldDark}" Margin="0,6" />

                <Button x:Name="StartButton"
                        Text="开始游戏"
                        Style="{StaticResource PixelButtonPrimary}"
                        Clicked="OnStartClicked"
                        HorizontalOptions="Fill" />
                <Button x:Name="SelectMapButton"
                        Text="选择地图"
                        Style="{StaticResource PixelButton}"
                        Clicked="OnSelectMapClicked"
                        HorizontalOptions="Fill" />
                <Button x:Name="LoadButton"
                        Text="读取存档"
                        Style="{StaticResource PixelButton}"
                        Clicked="OnLoadClicked"
                        HorizontalOptions="Fill" />

                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,8,0,0">
                    <Label Text="静音" Style="{StaticResource PixelLabel}" FontSize="14" VerticalOptions="Center" />
                    <Switch x:Name="MuteSwitch" Toggled="OnMuteToggled" VerticalOptions="Center" />
                    <Label Text="音量" Style="{StaticResource PixelLabel}" FontSize="14" VerticalOptions="Center" Margin="8,0,0,0" />
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" WidthRequest="120"
                            ValueChanged="OnVolumeChanged" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label x:Name="StatusLabel"
                       Text=""
                       Style="{StaticResource PixelLabel}"
                       FontSize="13"
                       Opacity="0.9"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>
