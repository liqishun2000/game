<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="MauiApp.Pages.WorldMapPage"
             Title="大地图"
             BackgroundColor="#1c2028">

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Padding="12,8" BackgroundColor="#252b35">
            <Label x:Name="HudLabel" TextColor="White" FontSize="15" />
        </Border>

        <skia:SKCanvasView Grid.Row="1"
                           x:Name="MapCanvas"
                           EnableTouchEvents="True"
                           PaintSurface="OnPaintSurface"
                           Touch="OnCanvasTouch" />

        <Border Grid.Row="2" Padding="12" BackgroundColor="#252b35">
            <VerticalStackLayout Spacing="8">
                <Label x:Name="TileLabel" TextColor="White" FontSize="14" Text="点击地图选择地盘" />
                <HorizontalStackLayout Spacing="8">
                    <Button x:Name="BuildButton" Text="建造" Clicked="OnBuildClicked" IsEnabled="False" />
                    <Button x:Name="RecruitButton" Text="招兵" Clicked="OnRecruitClicked" IsEnabled="False" />
                    <Button x:Name="TechButton" Text="科技" Clicked="OnTechClicked" />
                    <Button x:Name="AttackButton" Text="出征" Clicked="OnAttackClicked" IsEnabled="False" />
                    <Button x:Name="SaveButton" Text="保存" Clicked="OnSaveClicked" />
                    <Button x:Name="EndTurnButton" Text="结束本月" Clicked="OnEndTurnClicked" BackgroundColor="#3a8a4a" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
